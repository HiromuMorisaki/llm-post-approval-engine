# ローカル実行用。コピーして .env を作成する（.env は .gitignore 済み）
# GitHub Actions では Settings > Secrets and variables > Actions に同名で登録する

# LLM（API生成モードを使う場合のみ）
GEMINI_API_KEY=

# Google Sheets（投稿管理シート）
GOOGLE_CREDENTIALS=   # サービスアカウントJSONの中身（ローカルでは credentials.json でも可）
SPREADSHEET_ID=

# X (Twitter) API
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Threads API（メインアカウント）
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# Threads API（サブアカウント。使わなければ空のまま）
THREADS_ACCESS_TOKEN_SHIGOTO=
THREADS_USER_ID_SHIGOTO=
THREADS_ACCESS_TOKEN_PAPA=
THREADS_USER_ID_PAPA=

# X の計測を有効にする（X API Basic 以上）
MEASURE_X=false
